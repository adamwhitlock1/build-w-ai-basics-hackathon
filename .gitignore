# Devpost Learn — keep personal learning context out of commits by default.
# Note: this only affects what gets committed. Your AI provider still sees
# the file through the conversation; this is about what becomes public.
/devpost/learner-profile.md

# Local credentials — API keys live in backend/.env (never committed).
.env
.env.*
!.env.example

# Local data and build output
backend/*.db
backend/*.db.*
backend/*.db-*
backend/bin/
# Genkit Dev UI traces (make dev-ui): full prompts and replies, family data.
backend/.genkit/
node_modules/
frontend/dist/

# OS clutter
.DS_Store
